# 仅服务端使用；不要改成 NEXT_PUBLIC_ 前缀，也不要提交真实密钥。
ZAI_API_KEY=
ZHIPU_KNOWLEDGE_ID=
# 回答模型。每问约 1.1 万输入 token：glm-4.5-air（付费，约 1 分钱/问）实测首字约 2 秒；
# glm-4.7 系列（含付费的 flashx）这么长的提示词首字要 20 秒左右，免费的 glm-4.7-flash 高峰期还常报 1305。
# 不想付费就改用免费的 glm-4-flash-250414
ZHIPU_MODEL=glm-4.5-air
# 可选：主模型过载、限流或 8 秒内没开始响应（排队）时改用这个再试一次，留空则不重试
ZHIPU_FALLBACK_MODEL=glm-4-flash-250414
