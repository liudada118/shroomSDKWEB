{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run pack:sdk && npm run pack:skill && npm run build:docs && vinext build",
    "start": "vinext start",
    "pack:sdk": "node scripts/pack-sdk.mjs",
    "pack:skill": "node scripts/pack-integration-skill.mjs",
    "build:sdk-bundle": "node scripts/build-sdk-bundle.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "test:knowledge": "npm run build:docs && node --experimental-strip-types --test server/*.test.ts",
    "test:sdk": "npm --prefix sdk run test:sdk",
    "test:python": "npm --prefix sdk run test:python",
    "test:integration": "node --test scripts/tests/*.test.mjs",
    "sdk:init": "git submodule update --init --recursive",
    "sdk:check": "node scripts/check-sdk-source.mjs && node sdk/scripts/sdk-check.mjs",
    "sdk:verify": "npm --prefix sdk run sdk:verify",
    "verify": "node scripts/verify-site.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "0.27.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fflate": "0.7.5",
    "marked": "^18.0.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
