{
  "name": "shroom-sdk",
  "version": "0.1.0",
  "description": "Shroom 产品 SDK：取数、WS、分区渲染、带标签录制与下载",
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./web/index.js" },
    "./web": { "types": "./index.d.ts", "default": "./web/index.js" },
    "./node": { "types": "./node/index.d.ts", "default": "./node/index.js" },
    "./backend": {
      "types": "./backend/client.d.ts",
      "browser": "./backend/client.js",
      "node": "./node/backend.js",
      "default": "./backend/client.js"
    },
    "./core": "./core/frame.js"
  },
  "scripts": {
    "generate:examples": "node examples/generate-product-examples.mjs",
    "start": "node start.mjs",
    "demo": "node node/demo.js",
    "ports": "node node/demo.js --list",
    "demo:backend": "node node/backend-demo.js",
    "demo:quick": "node node/quick-demo.js",
    "demo:quick:mock": "node node/quick-demo.js --mock",
    "test:backend": "node --test tests/backend-client.test.mjs"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0",
    "ws": "^8.14.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true
}
